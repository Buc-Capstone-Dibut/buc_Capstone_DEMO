# Supabase 설정
# Supabase 프로젝트 URL (대시보드 > Project Settings > API에서 확인 가능)
NEXT_PUBLIC_SUPABASE_URL=https://oqepcpnkhhotkberqyhz.supabase.co

# Supabase Anon Key (클라이언트용 공개 키)
# 로그인, 데이터 읽기 등 클라이언트 사이드 작업에 사용됩니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase Service Role Key (서버 사이드 전용)
# Next.js API Routes 등 서버 환경에서 관리자 권한으로 DB에 접근할 때 사용됩니다.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Prisma (Postgres direct connection)
# API Routes에서 Prisma를 사용하는 경우 필수입니다.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres

# LiveKit 설정 (화상 면접 기능용)
# 로컬 개발 시: ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# 실행 환경 설정
# development: 개발 환경, production: 배포 환경
NODE_ENV=development

# Fireworks AI 설정 (옵션)
# AI 모델을 통한 태그 생성 및 분석 기능에 사용됩니다.
FIREWORKS_API_KEY=your_fireworks_api_key

# AI Interview FastAPI Base URL (Server-side BFF proxy target)
AI_INTERVIEW_BASE_URL=http://localhost:8001

# AI Interview WebSocket URL (Client-side voice interview skeleton)
NEXT_PUBLIC_AI_WS_URL=ws://localhost:8001/v1/interview/ws/client

# AI Admin API Base URL
NEXT_PUBLIC_AI_ADMIN_BASE_URL=http://localhost:8001/admin

# Fireworks AI 모델 설정 (옵션)
FIREWORKS_MODEL=

# 서버 간 내부 통신 인증 시크릿 (화이트보드 저장 API)
# workspace-server(Render)의 INTERNAL_API_SECRET 값과 반드시 동일해야 함
# 배포 전 긴 랜덤 문자열로 교체 필요 (예: openssl rand -hex 32)
INTERNAL_API_SECRET=your-secret-here

# --- Vertex AI (선택) ---
# Gemini 호출을 AI Studio 키 대신 Vertex(GCP 크레딧)로 보낸다. AI Studio prepayment 와 무관.
# true 면 아래 자격증명으로 Vertex 사용, false/미설정이면 GEMINI_API_KEY 로 폴백.
# 로컬: GOOGLE_APPLICATION_CREDENTIALS 에 서비스 계정 JSON 파일 경로
# 배포(Render): 파일 대신 GEMINI_SERVICE_ACCOUNT_JSON_BASE64 에 base64 인코딩 JSON 권장
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# GEMINI_SERVICE_ACCOUNT_JSON_BASE64=
