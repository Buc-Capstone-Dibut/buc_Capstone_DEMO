{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "ai-interview",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "ai-interview", "uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "workspace-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "workspace-server", "run", "dev"],
      "port": 4000
    },
    {
      "name": "understand-dashboard",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd \"$HOME/.understand-anything-plugin/packages/dashboard\" && GRAPH_DIR=/Users/junghwan/buc_Capstone_DEMO UNDERSTAND_ACCESS_TOKEN=dibut-graph exec npx vite --host 127.0.0.1 --port 5175 --strictPort"],
      "port": 5175
    }
  ]
}
