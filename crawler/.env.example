# Supabase 설정
# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=https://oqepcpnkhhotkberqyhz.supabase.co

# Supabase Anon Key (필요시 사용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase Service Role Key (필수: DB 쓰기 권한)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Vertex AI 설정 (AI 이벤트 요약/블로그 태깅)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# 서비스 계정 인증: base64 JSON 또는 로컬 파일 경로 중 하나
GOOGLE_SERVICE_ACCOUNT_JSON_B64=your_service_account_json_base64
GOOGLE_APPLICATION_CREDENTIALS=

# Firecrawl API 키 (옵션: 이벤트 상세 페이지 마크다운 크롤링용)
FIRECRAWL_API_KEY=your_firecrawl_api_key

# 이메일 알림 설정 (옵션)
EMAIL_SENDER=your_email@gmail.com
EMAIL_RECEIVER=receiver_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password

# 크롤링 설정 (옵션)
TAG_REQUEST_DELAY_MS=1000
TAG_RETRY_BASE_MS=5000

# 저장 테이블 설정 (옵션)
SUPABASE_BLOGS_TABLE=blogs
